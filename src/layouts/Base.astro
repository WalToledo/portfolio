---
// Layout base: envuelve cada página con head, navbar, main y footer.
// "title" es una prop: cada página puede pisar el título de la pestaña.
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = 'Walter Toledo' } = Astro.props;
---

<html lang="es" class="motion-safe:scroll-smooth">
  <head>
    <script is:inline>
      // Aplica el tema guardado (o la preferencia del SO) antes del primer render,
      // para evitar el flash de tema incorrecto (FOUC).
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored ? stored === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col overflow-x-hidden bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-black focus:outline focus:outline-2 focus:outline-blue-500 focus:outline-offset-2"
    >
      Saltar al contenido
    </a>

    <Navbar />

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
