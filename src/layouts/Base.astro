---
// Layout base: envuelve cada página con head, navbar, main y footer.
// "title" es una prop: cada página puede pisar el título de la pestaña.
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = 'Walter Toledo' } = Astro.props;
---

<html lang="es" class="motion-safe:scroll-smooth">
  <head>
    <script is:inline>
      // Aplica el tema guardado (o la preferencia del SO) antes del primer render,
      // para evitar el flash de tema incorrecto (FOUC).
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored ? stored === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <!-- Space Grotesk 700 es la fuente del h1 del Hero, above-the-fold: se precarga
         para que esté lista apenas el CSS la pide, sin esperar al descubrimiento normal. -->
    <link rel="preload" href="/fonts/space-grotesk-700.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <noscript>
      <style>
        /* Sin JS no hay quién agregue .is-revealed: mostramos todo directamente
           en vez de dejar contenido invisible. */
        [data-reveal],
        [data-reveal-load] {
          opacity: 1 !important;
          transform: none !important;
          animation: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="flex min-h-screen flex-col overflow-x-hidden bg-canvas text-ink">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-surface focus:px-4 focus:py-2 focus:text-ink focus:outline focus:outline-2 focus:outline-accent focus:outline-offset-2"
    >
      Saltar al contenido
    </a>

    <Navbar />

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <Footer />

    <script>
      // Revela cada sección marcada con data-reveal una sola vez al entrar en
      // viewport. rootMargin negativo evita que dispare apenas se asoma el borde.
      const revealTargets = document.querySelectorAll('[data-reveal]');

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -10% 0px' }
        );
        revealTargets.forEach((target) => observer.observe(target));
      } else {
        revealTargets.forEach((target) => target.classList.add('is-revealed'));
      }
    </script>
  </body>
</html>
