---
// Layout base: envuelve cada página con head, navbar, main y footer.
// "title" es una prop: cada página puede pisar el título de la pestaña.
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { translations } from '../data/i18n';

interface Props {
  title?: string;
  description?: string;
}

// La description sigue el mismo patrón que el title: un default acá y cada
// página puede pisarlo. El texto sale del diccionario de i18n (meta.title /
// meta.description), que es la misma fuente que usa el toggle de idioma.
const { title = translations.es.meta.title, description = translations.es.meta.description } = Astro.props;

// Canonical y og:image tienen que ser URLs ABSOLUTAS: una ruta relativa deja la
// preview sin imagen en WhatsApp/LinkedIn. Astro.site viene de "site" en
// astro.config.mjs; Astro.url.pathname mantiene el canonical correcto si algún
// día se agrega una segunda página.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<html lang="es" class="motion-safe:scroll-smooth">
  <head>
    <script is:inline>
      // Aplica el tema guardado (o la preferencia del SO) antes del primer render,
      // para evitar el flash de tema incorrecto (FOUC).
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored ? stored === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', isDark);
      })();
      // Idioma guardado: solo fija el atributo lang antes del render (el
      // contenido se renderiza en español y recién lo traduce el script del
      // Navbar una vez cargado el DOM). Evita que <html lang> quede
      // desincronizado del idioma elegido mientras el resto del JS carga.
      (function () {
        const storedLang = localStorage.getItem('lang');
        document.documentElement.lang = storedLang === 'en' ? 'en' : 'es';
      })();
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <!-- Space Grotesk 700 es la fuente del h1 del Hero, above-the-fold: se precarga
         para que esté lista apenas el CSS la pide, sin esperar al descubrimiento normal. -->
    <link rel="preload" href="/fonts/space-grotesk-700.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title data-i18n="meta.title">{title}</title>
    <meta name="description" content={description} data-i18n-content="meta.description" />
    <link rel="canonical" href={canonical} />
    <meta name="author" content="Walter Toledo" />

    <!-- Open Graph: lo que leen WhatsApp, LinkedIn y Facebook al compartir el link.
         Reusa title y description en vez de repetir el texto: una sola fuente. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Walter Toledo" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Walter Toledo, Desarrollador de Software Fullstack: tarjeta con su foto de perfil, su nombre y su frase de presentación."
    />

    <!-- Twitter/X no lee og: para el formato de la tarjeta, necesita las suyas.
         summary_large_image muestra la imagen de 1200×630 entera, no recortada. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Color de la barra del navegador en mobile. Son los mismos valores de
         --color-canvas (global.css) para cada tema, así no desentona con la página. -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0b" />
    <noscript>
      <style>
        /* Sin JS no hay quién agregue .is-revealed: mostramos todo directamente
           en vez de dejar contenido invisible. */
        [data-reveal],
        [data-reveal-load] {
          opacity: 1 !important;
          transform: none !important;
          animation: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="flex min-h-screen flex-col overflow-x-hidden bg-canvas text-ink antialiased selection:bg-accent/20">
    <a
      href="#contenido"
      data-i18n="nav.skipLink"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-control focus:border focus:border-border focus:bg-surface focus:px-4 focus:py-2 focus:text-ink focus:shadow-(--shadow-card-hover) focus:outline-2 focus:outline-offset-2 focus:outline-accent"
    >
      Saltar al contenido
    </a>

    <Navbar />

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <Footer />

    <script>
      // Revela cada sección marcada con data-reveal una sola vez al entrar en
      // viewport. rootMargin negativo evita que dispare apenas se asoma el borde.
      const revealTargets = document.querySelectorAll('[data-reveal]');

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -10% 0px' }
        );
        revealTargets.forEach((target) => observer.observe(target));
      } else {
        revealTargets.forEach((target) => target.classList.add('is-revealed'));
      }
    </script>
  </body>
</html>
