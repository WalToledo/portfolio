---
import { projects } from '../data/projects.ts';
import SectionHeading from './SectionHeading.astro';
import SocialIcon from './SocialIcon.astro';
import { translations } from '../data/i18n';

const t = translations.es.projects;
---

<section id="proyectos" class="scroll-mt-20 bg-band section-tint">
  <div class="mx-auto max-w-5xl px-4 py-20 sm:py-24">
    <div data-reveal>
      <SectionHeading eyebrow={t.eyebrow} title={t.title} eyebrowKey="projects.eyebrow" titleKey="projects.title" />
    </div>

    <!-- .projects-grid / .project-card usan CSS subgrid (ver global.css): cada
         card ocupa 3 filas del contenedor y mapea sus filas a las del padre, así
         los chips y la línea separadora del link quedan a la misma altura en
         todas las cards de la fila, sin min-h con números mágicos. -->
    <div class="projects-grid mt-10">
      {projects.map(({ title, description, stack, repoUrl }, index) => (
        <article
          data-reveal
          style={`--reveal-delay: ${index * 90}ms`}
          class="project-card card card-interactive p-6"
        >
          <div>
            <h3 class="project-title font-display text-xl font-medium">{title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted" data-i18n-es={description.es} data-i18n-en={description.en}>
              {description.es}
            </p>
          </div>

          <!-- El bloque de stack se alinea al FINAL de su fila del subgrid: como
               las descripciones miden distinto, el aire sobrante queda entre la
               descripción y los chips (lectura intencional) en vez de abrirse un
               hueco entre los chips y la línea del link. -->
          <div class="flex flex-col justify-end gap-2.5">
            <p class="font-mono text-[0.6875rem] font-medium tracking-[0.18em] text-muted uppercase" data-i18n="projects.stackLabel">
              {t.stackLabel}
            </p>
            <ul class="flex flex-wrap gap-2">
              {stack.map((tech) => (
                <li class="chip">{tech}</li>
              ))}
            </ul>
          </div>

          <div class="border-t border-border pt-4">
            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="project-link focus-ring inline-flex items-center gap-2 rounded-chip text-sm font-medium text-accent-text"
            >
              <SocialIcon name="github" class="h-4 w-4 shrink-0" />
              {/* El texto visible queda corto y el nombre accesible sigue siendo
                  específico ("Ver repositorio de CineTracker"), como pide SPECS. */}
              <span data-i18n="projects.viewRepo">{t.viewRepo}</span>
              <span class="sr-only"> <span data-i18n="projects.of">{t.of}</span> {title}</span>
              <SocialIcon name="arrow-right" class="project-arrow h-4 w-4 shrink-0" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
