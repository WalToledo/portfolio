---
import { projects } from '../data/projects.ts';
---

<section id="proyectos" class="scroll-mt-20 mx-auto max-w-5xl px-4 py-16">
  <h2 class="text-3xl font-bold">Proyectos</h2>

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map(({ title, description, stack, repoUrl }) => (
      <article class="flex flex-col rounded border border-gray-200 p-5 dark:border-gray-800">
        <h3 class="text-xl font-semibold">{title}</h3>
        <p class="mt-2 text-gray-700 dark:text-gray-300">{description}</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {stack.map((tech) => (
            <li class="rounded bg-gray-100 px-3 py-1 text-sm dark:bg-gray-800">{tech}</li>
          ))}
        </ul>
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 text-sm font-medium underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-500 focus-visible:outline-offset-2"
        >
          Ver repositorio de {title}
        </a>
      </article>
    ))}
  </div>
</section>
