---
import { experience } from '../data/experience.ts';
---

<section id="experiencia" class="scroll-mt-20 mx-auto max-w-5xl px-4 py-16">
  <h2 class="text-3xl font-bold">Experiencia laboral</h2>

  <div class="mt-8 space-y-6">
    {experience.map(({ role, company, period }) => (
      <article class="rounded border border-gray-200 p-5 dark:border-gray-800">
        <h3 class="text-xl font-semibold">{role}</h3>
        <p class="mt-1 text-gray-700 dark:text-gray-300">{company}</p>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{period}</p>
      </article>
    ))}
  </div>
</section>
