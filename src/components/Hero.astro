---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpeg';

const name = 'Walter Toledo';
const role = 'Desarrollador de Software Fullstack';
const title = 'Analista en Sistemas Informáticos';
const tagline = 'Construyo productos web de punta a punta, del diseño al deploy.';
---

<section
  id="inicio"
  class="scroll-mt-20 mx-auto grid min-h-[70vh] max-w-5xl items-center gap-10 px-4 py-16 text-center md:grid-cols-[1.2fr_0.8fr] md:text-left"
>
  <div class="order-2 flex flex-col items-center gap-4 md:order-1 md:items-start">
    <h1 data-reveal-load style="--reveal-delay: 90ms" class="font-display text-4xl font-bold tracking-tight md:text-6xl">{name}</h1>
    <p data-reveal-load style="--reveal-delay: 160ms" class="text-xl font-medium text-muted">{role}</p>
    <p data-reveal-load style="--reveal-delay: 220ms" class="text-muted">{title}</p>
    <p data-reveal-load style="--reveal-delay: 280ms" class="max-w-md text-muted">{tagline}</p>

    <div data-reveal-load style="--reveal-delay: 340ms" class="mt-4 flex w-full flex-col gap-4 sm:w-auto sm:flex-row sm:flex-wrap">
      <a
        href="#proyectos"
        class="rounded-md bg-ink px-6 py-3 text-center font-medium text-canvas hover:bg-accent-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
      >
        Ver proyectos
      </a>
      <a
        href="#contacto"
        class="rounded-md border border-ink px-6 py-3 text-center font-medium hover:bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
      >
        Contactarme
      </a>
    </div>
  </div>

  <Image
    src={avatar}
    alt={`Foto de perfil de ${name}`}
    width={160}
    height={160}
    data-reveal-load
    style="--reveal-delay: 0ms"
    class="order-1 h-40 w-40 justify-self-center rounded-full object-cover md:order-2 md:justify-self-end"
  />
</section>
