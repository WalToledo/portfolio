---
import SocialIcon from './SocialIcon.astro';

// Año dinámico: se calcula en build time (SSG), no en el navegador.
const year = new Date().getFullYear();

const socialLinks = [
  { icon: 'github' as const, label: 'GitHub', href: 'https://github.com/WalToledo', external: true },
  { icon: 'linkedin' as const, label: 'LinkedIn', href: 'https://www.linkedin.com/in/walter-ariel-toledo', external: true },
  { icon: 'email' as const, label: 'Email', href: 'mailto:toledowalter836@gmail.com', external: false },
];
---

<footer class="border-t border-border bg-canvas">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-5 px-4 py-10 text-sm md:flex-row md:justify-between">
    <p class="text-muted">
      © {year} <span class="font-display font-medium text-ink">Walter Toledo</span>
    </p>

    <!-- py-1.5 agranda el blanco de toque: el texto solo daba 20px de alto y el
         mínimo de WCAG 2.2 (2.5.8) son 24px. No cambia nada visualmente. -->
    <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
      {socialLinks.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="focus-ring inline-flex items-center gap-2 rounded-chip py-1.5 text-muted transition-colors hover:text-accent-text"
          >
            <SocialIcon name={link.icon} class="h-4 w-4" />
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
