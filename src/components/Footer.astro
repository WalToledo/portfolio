---
// Año dinámico: se calcula en build time (SSG), no en el navegador.
const year = new Date().getFullYear();

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/WalToledo', external: true },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/walter-ariel-toledo', external: true },
  { label: 'Email', href: 'mailto:toledowalter836@gmail.com', external: false },
];
---

<footer class="border-t border-gray-200 py-8 dark:border-gray-800">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-4 text-sm md:flex-row md:justify-between">
    <p>© {year} Walter Toledo</p>

    <ul class="flex gap-4">
      {socialLinks.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="inline-flex items-center gap-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-500 focus-visible:outline-offset-2"
          >
            {link.label === 'GitHub' && (
              <svg class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.58 2 12.17c0 4.47 2.87 8.26 6.84 9.6.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.78.62-3.37-1.37-3.37-1.37-.46-1.19-1.11-1.51-1.11-1.51-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.17C22 6.58 17.52 2 12 2Z" />
              </svg>
            )}
            {link.label === 'LinkedIn' && (
              <svg class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.6v1.64h.05c.5-.95 1.73-1.95 3.56-1.95 3.81 0 4.5 2.51 4.5 5.77V21h-4v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9V21h-4V9Z" />
              </svg>
            )}
            {link.label === 'Email' && (
              <svg class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
            )}
            <span class="sr-only md:not-sr-only">{link.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
