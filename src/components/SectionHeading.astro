---
// Encabezado compartido por las 4 secciones (Sobre mí, Experiencia, Proyectos,
// Contacto). No es una sección: es una primitiva. Vive en un solo archivo para
// que los 4 encabezados no puedan divergir entre sí.
//
// Astro: "Props" es el contrato de entrada del componente. Los valores que le
// pasás como atributos (<SectionHeading eyebrow="Perfil" ... />) llegan por
// Astro.props, igual que los props de un componente de React, pero se resuelven
// en build time: no viaja nada de esto al navegador.
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<div class="flex flex-col gap-3">
  <!-- Queda el filete de acento como ancla a la izquierda del rótulo: sin él la
       palabra suelta pierde el enganche con el borde del bloque. -->
  <p class="flex items-center gap-3 font-mono text-xs font-medium tracking-[0.18em] text-accent-text uppercase">
    <span aria-hidden="true" class="h-px w-6 bg-accent/40"></span>
    <span>{eyebrow}</span>
  </p>

  <h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
    {title}
  </h2>
</div>
