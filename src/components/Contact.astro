---
import SectionHeading from './SectionHeading.astro';
import SocialIcon from './SocialIcon.astro';

const contactLinks = [
  { icon: 'email' as const, label: 'Email', value: 'toledowalter836@gmail.com', href: 'mailto:toledowalter836@gmail.com', external: false },
  { icon: 'github' as const, label: 'GitHub', value: 'WalToledo', href: 'https://github.com/WalToledo', external: true },
  { icon: 'linkedin' as const, label: 'LinkedIn', value: 'walter-ariel-toledo', href: 'https://www.linkedin.com/in/walter-ariel-toledo', external: true },
];

// Access Key pública de Web3Forms: el sitio es estático (sin backend), así que el
// envío del formulario se hace por fetch directo a su API. Esta key está pensada
// para exponerse en el cliente, no es un secreto.
const WEB3FORMS_ACCESS_KEY = '9e169e33-9cb8-4ecc-83a0-b5c3d2ff8416';
---

<section id="contacto" class="scroll-mt-16 bg-canvas">
  <div class="mx-auto max-w-5xl px-4 py-20 sm:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
      <div data-reveal>
        <SectionHeading eyebrow="Hablemos" title="Tu mensaje" />

        <p class="mt-6 max-w-prose text-lg leading-relaxed text-muted">
          ¿Querés contactarme? Escribime por acá o mandame un mensaje con el formulario.
        </p>

        <!-- Cada vía de contacto es una card con el mismo lenguaje que Proyectos
             y Sobre mí (borde + superficie + acento en hover), en vez de filas
             sueltas: la columna izquierda deja de verse como una lista plana. -->
        <ul class="mt-8 flex flex-col gap-3">
          {contactLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="focus-ring card card-interactive group flex items-center gap-3 p-3"
              >
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-control border border-border bg-band text-muted transition-colors group-hover:border-accent group-hover:bg-accent-subtle group-hover:text-accent-text">
                  <SocialIcon name={link.icon} class="h-4 w-4" />
                </span>
                <span class="min-w-0">
                  <span class="block font-mono text-[0.6875rem] font-medium tracking-[0.18em] text-muted uppercase">
                    {link.label}
                  </span>
                  <span class="block truncate text-ink">{link.value}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <form
        id="contact-form"
        novalidate
        data-access-key={WEB3FORMS_ACCESS_KEY}
        data-reveal
        style="--reveal-delay: 100ms"
        class="card flex flex-col gap-4 p-6 sm:p-8"
      >
        <div class="flex flex-col gap-1.5">
          <label for="name" class="text-sm font-medium text-ink">Nombre</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            minlength="2"
            placeholder="Tu nombre"
            aria-describedby="name-error"
            class="field focus-ring"
          />
          <!-- min-h reserva el renglón del error: que aparezca no empuja el layout. -->
          <p id="name-error" aria-live="polite" class="min-h-5 text-sm text-danger-text"></p>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="email" class="text-sm font-medium text-ink">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            placeholder="nombre@ejemplo.com"
            aria-describedby="email-error"
            class="field focus-ring"
          />
          <p id="email-error" aria-live="polite" class="min-h-5 text-sm text-danger-text"></p>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="message" class="text-sm font-medium text-ink">Mensaje</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            minlength="10"
            maxlength="2000"
            placeholder="¿Sobre qué te gustaría conversar?"
            aria-describedby="message-hint message-error"
            class="field focus-ring resize-y"
          ></textarea>
          <!-- El límite se dice ANTES de escribir (no solo al fallar la
               validación) y el contador lo confirma mientras se tipea. -->
          <p id="message-hint" class="flex items-center justify-between gap-3 text-xs text-muted">
            <span>Entre 10 y 2000 caracteres</span>
            <span id="message-count" class="font-mono tabular-nums">0 / 2000</span>
          </p>
          <p id="message-error" aria-live="polite" class="min-h-5 text-sm text-danger-text"></p>
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <button type="submit" class="btn btn-primary focus-ring disabled:opacity-60">
            Enviar mensaje
            <SocialIcon name="arrow-right" class="h-4 w-4 shrink-0" />
          </button>
          <p id="form-status" role="status" aria-live="polite" class="text-sm text-muted"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  // Validación propia (en español) en vez de los tooltips nativos del navegador,
  // y envío por fetch a Web3Forms: el sitio es estático, no hay backend propio al que postear.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  // Los estados del envío se distinguen por color, no solo por el texto.
  const setStatus = (message: string, tone: 'info' | 'success' | 'error') => {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove('text-muted', 'text-accent-text', 'text-danger-text');
    statusEl.classList.add(
      tone === 'success' ? 'text-accent-text' : tone === 'error' ? 'text-danger-text' : 'text-muted'
    );
  };

  const errorMessages: Record<string, (input: HTMLInputElement | HTMLTextAreaElement) => string> = {
    name: (input) => {
      if (input.validity.valueMissing) return 'Ingresá tu nombre.';
      if (input.validity.tooShort) return 'El nombre es muy corto.';
      return '';
    },
    email: (input) => {
      if (input.validity.valueMissing) return 'Ingresá tu email.';
      if (input.validity.typeMismatch) return 'Ingresá un email válido.';
      return '';
    },
    message: (input) => {
      if (input.validity.valueMissing) return 'Escribí un mensaje.';
      if (input.validity.tooShort) return 'Contame un poco más (mínimo 10 caracteres).';
      if (input.validity.tooLong) return 'El mensaje no puede superar los 2000 caracteres.';
      return '';
    },
  };

  const validateField = (input: HTMLInputElement | HTMLTextAreaElement) => {
    const errorEl = document.getElementById(`${input.name}-error`);
    const message = errorMessages[input.name]?.(input) ?? '';
    if (errorEl) errorEl.textContent = message;
    input.setAttribute('aria-invalid', String(Boolean(message)));
    return message === '';
  };

  // Contador del textarea. maxlength ya frena el tipeo, pero el contador avisa
  // cuánto queda y se pone en rojo al tocar el techo.
  const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;
  const messageCount = document.getElementById('message-count');

  messageInput?.addEventListener('input', () => {
    if (!messageCount) return;
    const length = messageInput.value.length;
    messageCount.textContent = `${length} / 2000`;
    messageCount.classList.toggle('text-danger-text', length >= 2000);
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !statusEl || !submitButton) return;

    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea'));
    const validations = fields.map(validateField);
    const firstInvalid = fields[validations.findIndex((valid) => !valid)];

    if (firstInvalid) {
      setStatus('', 'info');
      firstInvalid.focus();
      return;
    }

    const data = new FormData(form);
    data.append('access_key', form.dataset.accessKey ?? '');

    submitButton.disabled = true;
    setStatus('Enviando…', 'info');

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      });
      const result = await response.json();

      if (result.success) {
        setStatus('¡Mensaje enviado! Te voy a responder pronto.', 'success');
        form.reset();
        // reset() no dispara "input", así que el contador hay que volverlo a 0 a mano.
        if (messageCount) {
          messageCount.textContent = '0 / 2000';
          messageCount.classList.remove('text-danger-text');
        }
      } else {
        throw new Error(result.message ?? 'Error desconocido');
      }
    } catch {
      setStatus(
        'No se pudo enviar el mensaje. Probá de nuevo o escribime directamente a toledowalter836@gmail.com.',
        'error'
      );
    } finally {
      submitButton.disabled = false;
    }
  });
</script>
