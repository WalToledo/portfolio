---
// Mismos links y SVGs que Footer.astro, para que contacto se vea consistente en toda la página.
const contactLinks = [
  { label: 'Email', href: 'mailto:toledowalter836@gmail.com', external: false },
  { label: 'GitHub', href: 'https://github.com/WalToledo', external: true },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/walter-ariel-toledo', external: true },
];

// Access Key pública de Web3Forms: el sitio es estático (sin backend), así que el
// envío del formulario se hace por fetch directo a su API. Esta key está pensada
// para exponerse en el cliente, no es un secreto.
const WEB3FORMS_ACCESS_KEY = '9e169e33-9cb8-4ecc-83a0-b5c3d2ff8416';
---

<section id="contacto" class="scroll-mt-20 mx-auto max-w-5xl px-4 py-16">
  <h2 class="text-3xl font-bold">Contacto</h2>
  <p class="mt-2 text-gray-700 dark:text-gray-300">
    ¿Querés contactarme? Escribime por acá o mandame un mensaje con el formulario.
  </p>

  <ul class="mt-6 flex flex-wrap gap-6">
    {contactLinks.map((link) => (
      <li>
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          class="inline-flex items-center gap-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-500 focus-visible:outline-offset-2"
        >
          {link.label === 'Email' && (
            <svg class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          )}
          {link.label === 'GitHub' && (
            <svg class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.58 2 12.17c0 4.47 2.87 8.26 6.84 9.6.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.78.62-3.37-1.37-3.37-1.37-.46-1.19-1.11-1.51-1.11-1.51-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.17C22 6.58 17.52 2 12 2Z" />
            </svg>
          )}
          {link.label === 'LinkedIn' && (
            <svg class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
              <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.6v1.64h.05c.5-.95 1.73-1.95 3.56-1.95 3.81 0 4.5 2.51 4.5 5.77V21h-4v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9V21h-4V9Z" />
            </svg>
          )}
          <span class="sr-only md:not-sr-only">{link.label}</span>
        </a>
      </li>
    ))}
  </ul>

  <form id="contact-form" novalidate data-access-key={WEB3FORMS_ACCESS_KEY} class="mt-8 flex max-w-xl flex-col gap-4">
    <div class="flex flex-col gap-1">
      <label for="name" class="text-sm font-medium">Nombre</label>
      <input
        id="name"
        name="name"
        type="text"
        required
        minlength="2"
        aria-describedby="name-error"
        class="w-full rounded border border-gray-300 bg-transparent px-3 py-2 text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-500 focus-visible:outline-offset-2 dark:border-gray-700 dark:text-gray-100"
      />
      <p id="name-error" aria-live="polite" class="text-sm text-red-600 dark:text-red-400"></p>
    </div>

    <div class="flex flex-col gap-1">
      <label for="email" class="text-sm font-medium">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        aria-describedby="email-error"
        class="w-full rounded border border-gray-300 bg-transparent px-3 py-2 text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-500 focus-visible:outline-offset-2 dark:border-gray-700 dark:text-gray-100"
      />
      <p id="email-error" aria-live="polite" class="text-sm text-red-600 dark:text-red-400"></p>
    </div>

    <div class="flex flex-col gap-1">
      <label for="message" class="text-sm font-medium">Mensaje</label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        minlength="10"
        aria-describedby="message-error"
        class="w-full rounded border border-gray-300 bg-transparent px-3 py-2 text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-500 focus-visible:outline-offset-2 dark:border-gray-700 dark:text-gray-100"
      ></textarea>
      <p id="message-error" aria-live="polite" class="text-sm text-red-600 dark:text-red-400"></p>
    </div>

    <button
      type="submit"
      class="self-start rounded bg-gray-900 px-5 py-2 font-medium text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-500 focus-visible:outline-offset-2 disabled:opacity-60 dark:bg-gray-100 dark:text-gray-900"
    >
      Enviar mensaje
    </button>

    <p id="form-status" role="status" aria-live="polite" class="text-sm"></p>
  </form>
</section>

<script>
  // Validación propia (en español) en vez de los tooltips nativos del navegador,
  // y envío por fetch a Web3Forms: el sitio es estático, no hay backend propio al que postear.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  const errorMessages: Record<string, (input: HTMLInputElement | HTMLTextAreaElement) => string> = {
    name: (input) => {
      if (input.validity.valueMissing) return 'Ingresá tu nombre.';
      if (input.validity.tooShort) return 'El nombre es muy corto.';
      return '';
    },
    email: (input) => {
      if (input.validity.valueMissing) return 'Ingresá tu email.';
      if (input.validity.typeMismatch) return 'Ingresá un email válido.';
      return '';
    },
    message: (input) => {
      if (input.validity.valueMissing) return 'Escribí un mensaje.';
      if (input.validity.tooShort) return 'Contame un poco más (mínimo 10 caracteres).';
      return '';
    },
  };

  const validateField = (input: HTMLInputElement | HTMLTextAreaElement) => {
    const errorEl = document.getElementById(`${input.name}-error`);
    const message = errorMessages[input.name]?.(input) ?? '';
    if (errorEl) errorEl.textContent = message;
    input.setAttribute('aria-invalid', String(Boolean(message)));
    return message === '';
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !statusEl || !submitButton) return;

    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea'));
    const validations = fields.map(validateField);
    const firstInvalid = fields[validations.findIndex((valid) => !valid)];

    if (firstInvalid) {
      statusEl.textContent = '';
      firstInvalid.focus();
      return;
    }

    const data = new FormData(form);
    data.append('access_key', form.dataset.accessKey ?? '');

    submitButton.disabled = true;
    statusEl.textContent = 'Enviando…';

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      });
      const result = await response.json();

      if (result.success) {
        statusEl.textContent = '¡Mensaje enviado! Te voy a responder pronto.';
        form.reset();
      } else {
        throw new Error(result.message ?? 'Error desconocido');
      }
    } catch {
      statusEl.textContent =
        'No se pudo enviar el mensaje. Probá de nuevo o escribime directamente a toledowalter836@gmail.com.';
    } finally {
      submitButton.disabled = false;
    }
  });
</script>
