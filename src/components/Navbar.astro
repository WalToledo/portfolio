---
import SocialIcon from './SocialIcon.astro';

const navLinks = [
  { href: '#inicio', label: 'Inicio', key: 'nav.inicio' },
  { href: '#sobre-mi', label: 'Sobre mí', key: 'nav.sobreMi' },
  { href: '#experiencia', label: 'Experiencia', key: 'nav.experiencia' },
  { href: '#proyectos', label: 'Proyectos', key: 'nav.proyectos' },
  { href: '#contacto', label: 'Contacto', key: 'nav.contacto' },
];
---

<!-- Floating island: el header solo posiciona (separado del borde superior),
     el fondo/borde/sombra de la isla viven en el <nav> de abajo. -->
<header id="site-header" class="sticky top-4 z-40 px-4">
  <!-- Grid de 3 columnas (auto / 1fr / auto) en vez de flex+justify-between:
       así el logo y el grupo de la derecha reservan su propia columna y la
       del medio (links) nunca puede invadirlos, por angosta que quede. -->
  <nav aria-label="Navegación principal" class="relative mx-auto grid h-16 max-w-6xl grid-cols-[auto_1fr_auto] items-center gap-4 rounded-3xl border border-border bg-canvas/80 px-4 backdrop-blur-md shadow-(--shadow-nav)">
    <a
      href="#inicio"
      class="focus-ring rounded-chip font-display text-lg font-bold tracking-tight text-ink"
    >
      Walter Toledo
    </a>

    <!-- Links centrados: el dropdown mobile pasa a fila inline recién en "lg"
         (1024px), no en "md" (768px): con el logo + los 5 links + el grupo de
         la derecha (toggle + Descargar CV) el contenido no entra cómodo antes
         de esa marca y todo empieza a partirse en dos líneas. En desktop es
         normal flow dentro de la columna central (1fr), centrado con
         justify-self; en mobile sigue siendo el dropdown de siempre
         (absolute), anclado a la hamburguesa. -->
    <ul
      id="nav-menu"
      class="absolute top-[calc(100%+0.5rem)] left-4 right-4 hidden flex-col gap-1 rounded-card border border-border bg-surface p-2 shadow-(--shadow-card-hover) lg:static lg:flex lg:w-auto lg:flex-row lg:justify-self-center lg:gap-1 lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none"
    >
      {navLinks.map((link) => (
        <li>
          <!-- aria-current="page" lo marca el IntersectionObserver de abajo. Se
               estila con la sintaxis arbitraria aria-[current=page] porque
               aria-current no está entre las variantes aria por defecto de Tailwind. -->
          <a
            href={link.href}
            data-i18n={link.key}
            class="focus-ring block rounded-control px-3 py-2 text-sm text-muted transition-colors hover:bg-band hover:text-ink aria-[current=page]:bg-accent-subtle aria-[current=page]:text-accent-text lg:py-1.5"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Grupo de la derecha: toggle de idioma, toggle de tema y Descargar CV
         (más la hamburguesa, que es mobile-only y abre el menú centrado de arriba). -->
    <div class="flex items-center gap-1 justify-self-end md:gap-3">
      <!-- Toggle de idioma ES/EN. El texto visible es el código del idioma AL
           QUE CAMBIA (no se traduce: son códigos ISO). El idioma inicial se
           aplica en Base.astro (script en <head>, solo fija <html lang>). -->
      <button
        id="lang-toggle"
        type="button"
        aria-pressed="false"
        aria-label="Cambiar a inglés (EN)"
        class="focus-ring inline-flex min-w-9 items-center justify-center rounded-control p-2.5 text-xs font-semibold tracking-wide text-muted transition-colors hover:bg-band hover:text-ink"
      >
        EN
      </button>

      <!-- Toggle de tema claro/oscuro. El tema inicial se aplica en Base.astro (script en <head>). -->
      <button
        id="theme-toggle"
        type="button"
        aria-pressed="false"
        aria-label="Cambiar a tema oscuro"
        class="focus-ring inline-flex rounded-control p-2.5 text-muted transition-colors hover:bg-band hover:text-ink"
      >
        <svg class="hidden h-5 w-5 dark:block" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5" />
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
        </svg>
        <svg class="h-5 w-5 dark:hidden" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
        </svg>
      </button>

      <!-- Descargar CV: a la derecha del toggle de tema. El texto se oculta en
           mobile (solo queda el ícono) para no competir por ancho con el
           toggle y la hamburguesa. -->
      <a
        href="/cv-walter-toledo.pdf"
        download
        type="application/pdf"
        aria-label="Descargar CV"
        data-i18n-aria-label="nav.downloadCv"
        class="focus-ring inline-flex items-center gap-2 rounded-control px-2.5 py-2.5 text-sm text-muted transition-colors hover:bg-band hover:text-ink sm:px-3"
      >
        <SocialIcon name="download" class="h-5 w-5" />
        <span class="hidden sm:inline" data-i18n="nav.downloadCv">Descargar CV</span>
      </a>

      <!-- Botón hamburguesa, solo mobile -->
      <button
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Abrir menú de navegación"
        class="focus-ring inline-flex rounded-control p-2.5 text-muted transition-colors hover:bg-band hover:text-ink lg:hidden"
      >
        <svg class="h-6 w-6" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  import { translations } from '../data/i18n';

  const root = document.documentElement;

  // Lee una ruta tipo "nav.downloadCv" dentro de un objeto de traducciones.
  const getByPath = (obj: unknown, path: string): string | undefined =>
    path.split('.').reduce<unknown>((acc, key) => {
      if (acc && typeof acc === 'object' && key in acc) return (acc as Record<string, unknown>)[key];
      return undefined;
    }, obj) as string | undefined;

  const currentLang = (): 'es' | 'en' => (root.lang === 'en' ? 'en' : 'es');

  // Toggle de tema: invierte la clase "dark" en <html> y guarda la preferencia.
  const themeToggle = document.getElementById('theme-toggle');

  const syncThemeToggle = () => {
    const isDark = root.classList.contains('dark');
    const t = translations[currentLang()].nav;
    themeToggle?.setAttribute('aria-pressed', String(isDark));
    themeToggle?.setAttribute('aria-label', isDark ? t.themeToLight : t.themeToDark);
  };

  syncThemeToggle();

  themeToggle?.addEventListener('click', () => {
    const isDark = root.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    syncThemeToggle();
  });

  // Toggle de idioma: traduce todo el texto marcado con data-i18n* y guarda
  // la preferencia. El texto del botón siempre es el código del idioma AL
  // QUE CAMBIA (no se traduce: son códigos ISO).
  const langToggle = document.getElementById('lang-toggle');

  const applyLang = (lang: 'es' | 'en') => {
    root.lang = lang;
    const dict = translations[lang];

    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      const value = getByPath(dict, el.dataset.i18n ?? '');
      if (value !== undefined) el.textContent = value;
    });

    document.querySelectorAll<HTMLElement>('[data-i18n-aria-label]').forEach((el) => {
      const value = getByPath(dict, el.dataset.i18nAriaLabel ?? '');
      if (value !== undefined) el.setAttribute('aria-label', value);
    });

    document.querySelectorAll<HTMLElement>('[data-i18n-placeholder]').forEach((el) => {
      const value = getByPath(dict, el.dataset.i18nPlaceholder ?? '');
      if (value !== undefined) el.setAttribute('placeholder', value);
    });

    document.querySelectorAll<HTMLElement>('[data-i18n-content]').forEach((el) => {
      const value = getByPath(dict, el.dataset.i18nContent ?? '');
      if (value !== undefined) el.setAttribute('content', value);
    });

    document.querySelectorAll<HTMLElement>('[data-i18n-alt]').forEach((el) => {
      const value = getByPath(dict, el.dataset.i18nAlt ?? '');
      if (value !== undefined) el.setAttribute('alt', value);
    });

    // Contenido dinámico de los data files (experience/projects/skills): cada
    // nodo ya trae ambos idiomas en sus propios data-attributes.
    document.querySelectorAll<HTMLElement>('[data-i18n-es][data-i18n-en]').forEach((el) => {
      const value = lang === 'en' ? el.dataset.i18nEn : el.dataset.i18nEs;
      if (value !== undefined) el.textContent = value;
    });

    langToggle?.setAttribute('aria-pressed', String(lang === 'en'));
    langToggle?.setAttribute('aria-label', lang === 'en' ? 'Switch to Spanish (ES)' : 'Cambiar a inglés (EN)');
    if (langToggle) langToggle.textContent = lang === 'en' ? 'ES' : 'EN';

    syncThemeToggle();
    syncMenuAria();

    // Otros componentes (ej. la validación del form de Contacto) escuchan
    // este evento para re-traducir mensajes dinámicos que no son data-i18n.
    document.dispatchEvent(new CustomEvent('app:langchange', { detail: { lang } }));
  };

  langToggle?.addEventListener('click', () => {
    const next = currentLang() === 'en' ? 'es' : 'en';
    localStorage.setItem('lang', next);
    applyLang(next);
  });

  // Menú mobile: abrir/cerrar, cerrar con Escape, cerrar al elegir un link.
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  const syncMenuAria = () => {
    const isOpen = toggle?.getAttribute('aria-expanded') === 'true';
    const t = translations[currentLang()].nav;
    toggle?.setAttribute('aria-label', isOpen ? t.closeMenu : t.openMenu);
  };

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    menu?.classList.toggle('flex', open);
    toggle?.setAttribute('aria-expanded', String(open));
    syncMenuAria();
  };

  // Sincroniza con el idioma que ya fijó el anti-flash de Base.astro (por si
  // el usuario había elegido inglés en una visita anterior).
  applyLang(currentLang());

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!isOpen);
  });

  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  // Link activo del nav según la sección visible: depende del scroll.
  const sections = Array.from(document.querySelectorAll<HTMLElement>('main section[id]'));
  const linksByHash = new Map(
    Array.from(menu?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? []).map((a) => [a.hash, a])
  );

  // Línea de referencia debajo del navbar flotante (top-4 + h-16 = 80px): la
  // sección activa es la última cuyo borde superior ya la cruzó. Con margen de
  // 16px extra sobre esos 80px: al hacer click en un link, scroll-mt-20 deja el
  // top de la sección en ~80px y por redondeo a veces queda en 80.x, lo que
  // fallaba el "<= 80" y el link no se iluminaba hasta scrollear un poco más.
  const MARKER_Y = 96;

  const syncNav = () => {
    if (!sections.length) return;

    let current = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= MARKER_Y) current = section;
    }

    // Al final del documento la última sección puede no llegar nunca a cruzar la
    // línea (si es más corta que el viewport), así que gana por estar al fondo.
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    if (atBottom) current = sections[sections.length - 1];

    for (const [hash, link] of linksByHash) {
      if (hash === `#${current.id}`) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    }
  };

  syncNav();
  window.addEventListener('scroll', syncNav, { passive: true });
  window.addEventListener('resize', syncNav, { passive: true });
</script>
